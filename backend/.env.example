# PostgreSQL connection string
# Local:  postgresql://localhost/codebase_assistant
# Render: set automatically via render.yaml → DATABASE_URL
DATABASE_URL=postgresql://localhost/codebase_assistant

# Jina AI embeddings key — https://jina.ai
JINA_API_KEY=

# Groq LLM key — https://console.groq.com
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins
# Development: http://localhost:3000
# Production:  https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Optional API key guard. When set, all /api/* requests must include
# the header X-API-Key: <value>. Leave blank to disable.
API_KEY=

# Logging level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# Maximum number of files to ingest per repository (default: 1000)
MAX_FILES=1000

# Maximum file size in bytes to ingest (default: 500000 = 500 KB)
MAX_FILE_BYTES=500000

# Set to false to skip Jina entirely — ingestion is near-instant and uses
# PostgreSQL full-text search only. Good for large repos or when rate-limited.
# Default: true (hybrid vector + keyword search)
USE_EMBEDDINGS=true

# Jina embedding tuning (only relevant when USE_EMBEDDINGS=true)
# MAX_EMBED_CHARS: characters sent per chunk to Jina (default 1500 ≈ 375 tokens)
MAX_EMBED_CHARS=1500
# EMBED_BATCH_SIZE: chunks per Jina API call (default 32)
EMBED_BATCH_SIZE=32
# EMBED_CONCURRENCY: number of parallel Jina calls (default 3)
EMBED_CONCURRENCY=3
